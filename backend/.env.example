# HOWDI backend environment template
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/howdi

# OpenAI / HOWDI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Public URLs / CORS
HOWDI_PUBLIC_API_URL=http://localhost:5000
HOWDI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin/session security
HOWDI_ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Payments
HOWDI_PAYMENT_PROVIDER=
HOWDI_PAYMENT_ADAPTER_SECRET=
HOWDI_PAYMENT_METHODS=COD,UPI,CARD,SAVED
HOWDI_PAYMENT_HOLD_MINUTES=30
HOWDI_PAYMENT_MAX_ATTEMPTS=3
HOWDI_DEV_PAYMENT_SIMULATION=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# HOWDI Connect: secret key for the opaque member references shown in the browser (set a long random value in production;
# if unset the server falls back to DATABASE_URL, and changing it invalidates refs already held by open browser sessions)
HOWDI_CONNECT_REF_SECRET=

# Security hashing peppers
KYC_HASH_PEPPER=
BANK_HASH_PEPPER=

# Shipping
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_TRACKING_POLL_ENABLED=false
SHIPROCKET_TRACKING_POLL_MINUTES=30

# Messaging
WHATSAPP_WEBHOOK_SECRET=

# Runtime / performance
NODE_ENV=development
HOWDI_SLOW_QUERY_MS=750
HOWDI_UPLOAD_MAX_BYTES=10485760

# Rate-limit client identity (K5A Connect Home, K5B Global Search).
# Leave EMPTY unless the server sits behind your own reverse proxy / load balancer. When empty, X-Forwarded-For,
# Forwarded, X-Real-IP etc. are ignored and guests are keyed by the direct connection address. When set, list ONLY the
# proxy addresses/CIDRs that connect to this server (comma-separated, IPv4/IPv6); X-Forwarded-For is then read
# right-to-left from those peers only. Invalid entries are ignored (fail closed).
HOWDI_TRUSTED_PROXIES=

# HPay add money through Cashfree — SANDBOX ONLY (see docs/HPAY_CASHFREE_SANDBOX.md). Leave empty to keep the fail-closed
# funding gate. Production mode/host are refused by the code. Also requires the HOWDI Preview/Test sandbox (a *_preview DB +
# HOWDI_PREVIEW_SANDBOX=1). Never commit real values.
CASHFREE_ENV=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
# Optional: https URL of the wallet screen for redirect-based payment methods (?cf_order={order_id} is appended)
HOWDI_CASHFREE_RETURN_URL=
# Optional: public https URL of POST /api/v8/hpay/cashfree/webhook (or configure it in the Cashfree sandbox dashboard)
HOWDI_CASHFREE_NOTIFY_URL=
