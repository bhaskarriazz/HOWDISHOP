# HOWDI backend environment template
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/howdi

# OpenAI / HOWDI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Public URLs / CORS
HOWDI_PUBLIC_API_URL=http://localhost:5000
HOWDI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin/session security
HOWDI_ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Payments
HOWDI_PAYMENT_PROVIDER=
HOWDI_PAYMENT_ADAPTER_SECRET=
HOWDI_PAYMENT_METHODS=COD,UPI,CARD,SAVED
HOWDI_PAYMENT_HOLD_MINUTES=30
HOWDI_PAYMENT_MAX_ATTEMPTS=3
HOWDI_DEV_PAYMENT_SIMULATION=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# Security hashing peppers
KYC_HASH_PEPPER=
BANK_HASH_PEPPER=

# Shipping
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_TRACKING_POLL_ENABLED=false
SHIPROCKET_TRACKING_POLL_MINUTES=30

# Messaging
WHATSAPP_WEBHOOK_SECRET=

# Runtime / performance
NODE_ENV=development
HOWDI_SLOW_QUERY_MS=750
HOWDI_UPLOAD_MAX_BYTES=10485760
